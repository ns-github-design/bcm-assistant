# Application mode: "mock" or "live"
MODE=mock

# Azure credentials (required for live mode only)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GitHub Copilot SDK authentication
# The SDK uses the Copilot CLI which authenticates via:
#   1. Logged-in user (default): run `copilot auth login` first
#   2. GitHub token: set COPILOT_GITHUB_TOKEN or GH_TOKEN
#   3. BYOK: configure a custom provider in agent/client.py
# No API key needed if you're logged in via the CLI.
COPILOT_GITHUB_TOKEN=
